# UNTESTED: derived from xtx-xt, not measured. Qwen3.8-Flash-Next NVFP4 on two RX 7900 XTX 24 GB, tensor parallel.
# Even split (identical cards). Expected from the memory plans of the tested profiles: ~3.7 GiB more per card for the
# expert cache than xtx-xt (~8.5k instead of 7.2k cached experts), so decode at least as fast as xtx-xt (55 tok/s).
# The tuned NVFP4 tiles are keyed to the 0.55 split: the even split's shapes use the default tiles (logged once).
# Needs ~81 GiB of host RAM while serving (128 GB machine). Please report what you measure.
TESTED=0
GPUS=2
# minimum VRAM per rank in GiB (the automatic GPU choice uses it)
VRAM_GIB="24 24"
CTX=262144
MEMORY=110g
TUNABLEOP=1
FREETOKEN_TP_ALLOW_IMBALANCE=1
FREETOKEN_INT8_DENSE=1
FREETOKEN_HOST_ALLREDUCE=1
FREETOKEN_NVFP4_PREFILL_TUNED=1
FREETOKEN_NVFP4_DECODE_TUNED=1
FREETOKEN_HOST_KV=1
FT_ARGS="--moe-strategy offload --moe-cache-auto --expert-load parallel --quant-backend moe.nvfp4=triton --ple-backend disk --max-running-requests 4 --cuda-graph-max-bs 4 --max-prefill-length 16384 --memory-ratio 0.80 --moe-prefill-hit-d2d --tp-size 2 --disable-pynccl --tool-call-parser qwen3_coder --reasoning-parser qwen3"
