# Qwen3.8-Flash-Next NVFP4 on two cards: RX 7900 XTX 24 GB (rank 0) + RX 7900 XT 20 GB (rank 1), tensor parallel.
# Measured (docs/rdna3/benchmarks.md, ROCm 10, MTP head on): decode 77 tok/s at the model's sampling (57.5 with
# --no-mtp), 72-86 tok/s greedy from 9k to 248k tokens of context; cold 8.3k-token prompt in 4.1 s; agent turn (~1k new
# tokens on a cached conversation) 1.3-2.0 s; up to 4 requests at once; contexts that leave the GPUs are kept in RAM
# and resume in ~2 s. Uses 82 GiB of host RAM while serving (128 GB machine recommended; see docs/rdna3/limits.md).
GPUS=2
# minimum VRAM per rank in GiB (the automatic GPU choice uses it)
VRAM_GIB="24 20"
CTX=250000
MEMORY=110g
TUNABLEOP=0
# larger card first; the XTX gets 55 % of the split work (measured optimum for 24 + 20 GB)
FREETOKEN_TP_ALLOW_IMBALANCE=1
FREETOKEN_TP_SPLIT=0.55
FREETOKEN_INT8_DENSE=1
FREETOKEN_HOST_ALLREDUCE=1
FREETOKEN_NVFP4_PREFILL_TUNED=1
FREETOKEN_NVFP4_DECODE_TUNED=1
FREETOKEN_HOST_KV=1
FREETOKEN_MTP=1                 # MTP draft head, greedy answers unchanged (rdna3/serve.sh --no-mtp turns it off)
FREETOKEN_SPEC_VERIFY_M=4       # up to 4 rows per verify step; the adaptive depth picks 2-4 (2 on one card)
FT_ARGS="--moe-strategy offload --moe-cache-auto --expert-load parallel --quant-backend moe.nvfp4=triton --ple-backend disk --max-running-requests 4 --cuda-graph-max-bs 4 --max-prefill-length 16384 --memory-ratio 0.80 --moe-prefill-hit-d2d --tp-size 2 --disable-pynccl --tool-call-parser qwen3_coder --reasoning-parser qwen3"
