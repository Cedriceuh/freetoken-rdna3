# Qwen3.8-Flash-Next NVFP4 on two cards: RX 7900 XTX 24 GB (rank 0) + RX 7900 XT 20 GB (rank 1), tensor parallel.
# Measured (docs/rdna3/benchmarks.md, MTP head on): decode 88 tok/s at serve.sh's sampling (65.5 with
# --no-mtp), 78-96 tok/s greedy from 9k to 260k tokens of context; cold 8.3k-token prompt in 3.8 s; agent turn (~1k new
# tokens on a cached conversation) 0.8-0.9 s; up to 4 requests at once; contexts that leave the GPUs are kept in RAM
# and resume in ~2 s. Uses 82 GiB of host RAM while serving (128 GB machine recommended; see docs/rdna3/limits.md).
GPUS=2
# minimum VRAM per rank in GiB (the automatic GPU choice uses it)
VRAM_GIB="24 20"
CTX=262144
MEMORY=110g
# larger card first; the XTX gets 55 % of the split work (measured optimum for 24 + 20 GB)
FREETOKEN_TP_ALLOW_IMBALANCE=1
FREETOKEN_TP_SPLIT=0.55
FREETOKEN_INT8_DENSE=1
FREETOKEN_HOST_ALLREDUCE=1
FREETOKEN_DMA_ALLREDUCE=1       # a prefill's all-reduces of 20 MiB or more by the copy engines: the same bits
FREETOKEN_NVFP4_PREFILL_TUNED=1
FREETOKEN_NVFP4_PREFILL_BLOCK=8192  # the prefill MoE 8192 tokens at a time: cold reads +8 % (an earlier build), the same bits
FREETOKEN_NVFP4_DECODE_TUNED=1
FREETOKEN_HOST_KV=1
FREETOKEN_MTP=1                 # MTP draft head, greedy answers unchanged (rdna3/serve.sh --no-mtp turns it off)
FREETOKEN_SPEC_VERIFY_M=4       # up to 4 rows per verify step; the adaptive depth picks 2-4 (2 on one card)
FREETOKEN_SPEC_BS_MAX=4         # up to four requests at once verify drafts (two agents: +8-15 % each, an earlier build),
FREETOKEN_SPEC_BS_DEEP=2        # 2 rows each past two: three requests NVFP4 +2-17 %, EXL3 +5-12 % (one run each)
FREETOKEN_SPARSE_LOGITS=1       # decode steps gather each rank's top-k logits, sampling in one kernel: the same answers
FREETOKEN_LMHEAD_SPLIT=1        # the LM head's rows split 0.55 like the experts: the same logits
FREETOKEN_DRAFT_VOCAB=latin     # the drafts score the Latin-script tokens only: the same answers measured
FT_ARGS="--moe-strategy offload --moe-cache-auto --expert-load parallel --quant-backend moe.nvfp4=triton --ple-backend disk --max-running-requests 4 --cuda-graph-max-bs 4 --max-prefill-length 16384 --memory-ratio 0.80 --moe-prefill-hit-d2d --tp-size 2 --disable-pynccl --tool-call-parser qwen3_coder --reasoning-parser qwen3"
