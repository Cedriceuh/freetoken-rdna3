# UNTESTED: derived from xt, not measured. Qwen3.8-Flash-Next NVFP4 on one RX 7900 GRE 16 GB (gfx1100).
# From the XT's memory plan (int8 dense weights 5.7 GiB, KV 3.1 GiB at 131k, 20 % headroom), 16 GB leaves only
# ~3-4 GiB for the expert cache (4-7 % of the experts cached, most expert reads cross PCIe) and the GRE has 576 GB/s of
# VRAM bandwidth (XT 800): expect ~20 tok/s at best. Context 64k and 4k prefill chunks to keep headroom; raise
# CTX (up to 131072) only after checking the free memory printed at start-up. Please report what you measure.
TESTED=0
GPUS=1
# minimum VRAM per rank in GiB (the automatic GPU choice uses it)
VRAM_GIB=16
CTX=65536
MEMORY=110g
TUNABLEOP=1
FREETOKEN_INT8_DENSE=1
FREETOKEN_NVFP4_PREFILL_TUNED=1
FREETOKEN_NVFP4_DECODE_TUNED=1
FREETOKEN_HOST_KV=1
FREETOKEN_HOST_KV_TOKENS=65536
FREETOKEN_HOST_KV_SNAPSHOTS=8
FT_ARGS="--moe-strategy offload --moe-cache-auto --expert-load parallel --quant-backend moe.nvfp4=triton --ple-backend disk --max-running-requests 1 --max-prefill-length 4096 --memory-ratio 0.80 --moe-prefill-hit-d2d --tp-size 1 --disable-pynccl --tool-call-parser qwen3_coder --reasoning-parser qwen3"
