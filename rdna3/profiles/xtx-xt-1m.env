# Experimental, measured with EXL3 3.05 bpw: one conversation of up to 1M tokens on 7900 XTX + 7900 XT.
# Qwen3.8-Flash-Next on RX 7900 XTX (rank 0) + RX 7900 XT (rank 1) with ~1M tokens of context:
# the attention K/V lives in host RAM (FREETOKEN_QSA_KV_HOST: the kernels read the selected tokens across PCIe, a
# prefill copies each layer's pages to VRAM first) and the plain rope runs past the native 262,144 positions
# (FREETOKEN_ROPE_MAX_POSITION, no YaRN: the same bits as xtx-xt below 262k). Measured with EXL3 3.05 bpw only
# (2026-10-10, docs/rdna3/long-context.md): 11.3k experts in the GPU caches, prompt reading 1970-2050 tok/s at 500k,
# 1775 at 990k (9.3 min), decode 84 tok/s at 118k, 92 at 500k, 84 at 990k; ~75 GiB of host RAM locked at 1M. NVFP4
# untested (its experts alone take 63 GiB of RAM).
GPUS=2
# minimum VRAM per rank in GiB (the automatic GPU choice uses it)
VRAM_GIB="24 20"
CTX=1000000
MEMORY=104g
TESTED=1
FREETOKEN_TP_ALLOW_IMBALANCE=1
FREETOKEN_TP_SPLIT=0.55
FREETOKEN_INT8_DENSE=1
FREETOKEN_HOST_ALLREDUCE=1
FREETOKEN_NVFP4_PREFILL_TUNED=1
FREETOKEN_NVFP4_DECODE_TUNED=1
FREETOKEN_HOST_KV=0             # the conversation tier would pin 9.5 GiB more; the K/V is already in RAM
FREETOKEN_QSA_KV_HOST=1
FREETOKEN_ROPE_MAX_POSITION=1048576
FREETOKEN_MTP=1                 # MTP draft head, greedy answers unchanged (rdna3/serve.sh --no-mtp turns it off)
FREETOKEN_SPEC_VERIFY_M=4
FREETOKEN_SPEC_BS_MAX=2
FT_ARGS="--moe-strategy offload --moe-cache-auto --expert-load parallel --quant-backend moe.nvfp4=triton --ple-backend disk --max-running-requests 4 --cuda-graph-max-bs 4 --max-prefill-length 16384 --memory-ratio 0.80 --moe-prefill-hit-d2d --tp-size 2 --disable-pynccl --tool-call-parser qwen3_coder --reasoning-parser qwen3"
