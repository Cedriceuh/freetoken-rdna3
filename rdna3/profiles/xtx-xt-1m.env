# Measured with EXL3 3.05 bpw: one conversation of up to 1M tokens on 7900 XTX + 7900 XT.
# Qwen3.8-Flash-Next on RX 7900 XTX (rank 0) + RX 7900 XT (rank 1) with ~1M tokens of context: the attention K/V lives
# in host RAM (FREETOKEN_QSA_KV_HOST: the kernels read the selected tokens across PCIe, a prefill copies the K/V rows
# it selects to VRAM first) and the rope table runs past the 262,144 positions the model was trained on
# (FREETOKEN_ROPE_MAX_POSITION: the same bits as xtx-xt below 262k). Measured with EXL3 3.05 bpw only
# (docs/rdna3/long-context.md, earlier builds, greedy): 11.3k experts in the GPU caches, prompt reading 2014 tok/s at
# 498k, 1780 at 988k (9.3 min), decode 84.2 tok/s at 118k, 93.0 at 498k, 84.7 at 988k; ~75 GiB of host RAM locked at
# 1M. NVFP4 untested (its experts alone take 63 GiB of RAM).
GPUS=2
# minimum VRAM per rank in GiB (the automatic GPU choice uses it)
VRAM_GIB="24 20"
CTX=1000000
MEMORY=104g
TESTED=1
FREETOKEN_TP_ALLOW_IMBALANCE=1
FREETOKEN_TP_SPLIT=0.55
FREETOKEN_INT8_DENSE=1
FREETOKEN_HOST_ALLREDUCE=1
FREETOKEN_NVFP4_PREFILL_TUNED=1
FREETOKEN_NVFP4_DECODE_TUNED=1
FREETOKEN_HOST_KV=0             # the conversation tier would pin 9.5 GiB more; the K/V is already in RAM
FREETOKEN_QSA_KV_HOST=1
FREETOKEN_ROPE_MAX_POSITION=1048576
FREETOKEN_MTP=1                 # MTP draft head, greedy answers unchanged (rdna3/serve.sh --no-mtp turns it off)
FREETOKEN_SPEC_VERIFY_M=4
FREETOKEN_SPEC_BS_MAX=4         # up to four requests at once verify drafts,
FREETOKEN_SPEC_BS_DEEP=2        # 2 rows each past two: three requests +10 %, four +4-12 % (EXL3, one run)
FT_ARGS="--moe-strategy offload --moe-cache-auto --expert-load parallel --quant-backend moe.nvfp4=triton --ple-backend disk --max-running-requests 4 --cuda-graph-max-bs 4 --max-prefill-length 16384 --memory-ratio 0.80 --moe-prefill-hit-d2d --tp-size 2 --disable-pynccl --tool-call-parser qwen3_coder --reasoning-parser qwen3"
