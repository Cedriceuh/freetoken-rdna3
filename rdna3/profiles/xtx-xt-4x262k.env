# Measured with EXL3 3.05 bpw (and NVFP4 with 3 contexts): conversations of up to 262,144 tokens at once.
# Qwen3.8-Flash-Next on RX 7900 XTX (rank 0) + RX 7900 XT (rank 1): the attention K/V lives in host RAM
# (FREETOKEN_QSA_KV_HOST), so the pool holds 4 full contexts (1.05M tokens) where xtx-xt shares 262k between the
# requests; each request stops at the model's native 262,144 positions. EXL3 3.05 bpw (docs/rdna3/long-context.md):
# 11.3k experts in the GPU caches; one pass: 4 cold 256k-token prompts read in 445 s, 4 agents at 257-260k decode at
# 29.6-31.6 tok/s each, one alone at 95.1 at 259k; a 142-360-token agent turn alone at 224k 0.46-0.59 s to the first
# token; ~77 GiB of host RAM locked. NVFP4 with `-- --kv-reserve-tokens 787500` (3 contexts; its experts alone take 63
# GiB of RAM): 130-340-token agent turns at 25k 0.58-0.70 s, a 259,728-token prompt read in 120 s; 94 GiB locked after
# the start, ~97 in use: fits the 126 GiB reference machine with little else running; four contexts (~100 GiB, with
# benchmark tools beside them) ran it out of memory. `rdna3/serve.sh --check` says what fits in your RAM.
GPUS=2
# minimum VRAM per rank in GiB (the automatic GPU choice uses it)
VRAM_GIB="24 20"
CTX=262144
KV_TOKENS=1050000               # the K/V pool the requests share: 4 x 262,144 and the decode's spare page per request
MEMORY=104g
TESTED=1
FREETOKEN_TP_ALLOW_IMBALANCE=1
FREETOKEN_TP_SPLIT=0.55
FREETOKEN_INT8_DENSE=1
FREETOKEN_HOST_ALLREDUCE=1
FREETOKEN_NVFP4_PREFILL_TUNED=1
FREETOKEN_NVFP4_PREFILL_BLOCK=8192  # the prefill MoE 8192 tokens at a time: cold reads +8 %, the same bits
FREETOKEN_NVFP4_DECODE_TUNED=1
FREETOKEN_HOST_KV=0             # the conversation tier would pin more RAM; the pool already holds the 4 contexts
FREETOKEN_QSA_KV_HOST=1
FREETOKEN_MTP=1                 # MTP draft head, greedy answers unchanged (rdna3/serve.sh --no-mtp turns it off)
FREETOKEN_SPEC_VERIFY_M=4
FREETOKEN_SPEC_BS_MAX=2         # three or four requests at once decode without drafts
FT_ARGS="--moe-strategy offload --moe-cache-auto --expert-load parallel --quant-backend moe.nvfp4=triton --ple-backend disk --max-running-requests 4 --cuda-graph-max-bs 4 --max-prefill-length 16384 --memory-ratio 0.80 --moe-prefill-hit-d2d --tp-size 2 --disable-pynccl --tool-call-parser qwen3_coder --reasoning-parser qwen3"
