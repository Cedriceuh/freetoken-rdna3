# Measured with EXL3 3.05 bpw (and NVFP4 with 3 contexts): four conversations of up to 262,144 tokens at once.
# Qwen3.8-Flash-Next on RX 7900 XTX (rank 0) + RX 7900 XT (rank 1): the attention K/V lives in host RAM
# (FREETOKEN_QSA_KV_HOST), so the pool holds 4 full contexts (1.05M tokens) where xtx-xt shares 262k between the
# requests; each request stops at the model's native 262,144 positions. EXL3 3.05 bpw (docs/rdna3/long-context.md):
# 11.3k experts in the GPU caches; one pass (an earlier build): 4 cold 256k-token prompts read in 445 s, 4 agents at
# 257-260k decode at 29.6-31.6 tok/s each, one alone at 95.1 at 259k; a 142-360-token agent turn alone at 224k
# 0.46-0.59 s to the first token; ~77 GiB of host RAM locked. NVFP4 with `-- --kv-reserve-tokens 787500` (3 contexts;
# its experts alone take 63 GiB of RAM): 130-340-token agent turns at 25k 0.58-0.70 s, a 259,728-token prompt read in
# 120 s; 94 GiB locked after the start, ~97 in use: fits the 126 GiB reference machine with little else running; four
# contexts (~100 GiB, with benchmark tools beside them) ran it out of memory. `rdna3/serve.sh --check` says what fits
# in your RAM.
GPUS=2
# minimum VRAM per rank in GiB (the automatic GPU choice uses it)
VRAM_GIB="24 20"
CTX=262144
KV_TOKENS=1050000               # the K/V pool the requests share: 4 x 262,144 and the decode's spare page per request
MEMORY=104g
EXL3_RATIO=0.78                 # rdna3/serve.sh's --memory-ratio for an EXL3 checkpoint below 4 bpw (0.77 elsewhere): see FT_ARGS
TESTED=1
FREETOKEN_TP_ALLOW_IMBALANCE=1
FREETOKEN_TP_SPLIT=0.55
FREETOKEN_INT8_DENSE=1
FREETOKEN_HOST_ALLREDUCE=1
FREETOKEN_DMA_ALLREDUCE=1       # a prefill's all-reduces of 20 MiB or more by the copy engines: the same bits
FREETOKEN_NVFP4_PREFILL_TUNED=1
FREETOKEN_NVFP4_PREFILL_BLOCK=8192  # the prefill MoE 8192 tokens at a time: cold reads +8 % (an earlier build), the same bits
FREETOKEN_NVFP4_DECODE_TUNED=1
FREETOKEN_HOST_KV=0             # the conversation tier would pin more RAM; the pool already holds the 4 contexts
FREETOKEN_QSA_KV_HOST=1
FREETOKEN_MTP=1                 # MTP draft head, greedy answers unchanged (rdna3/serve.sh --no-mtp turns it off)
FREETOKEN_SPEC_VERIFY_M=4
FREETOKEN_SPEC_BS_MAX=4         # three or four requests at once verify too,
FREETOKEN_SPEC_BS_DEEP=2        # 2 rows each past two: +6-9 % at three, +3-6 % at four greedy (T 0.6: -0.3 to +2.5 %)
FREETOKEN_SPARSE_LOGITS=1       # decode steps gather each rank's top-k logits, sampling in one kernel: the same answers
FREETOKEN_LMHEAD_SPLIT=1        # the LM head's rows split 0.55 like the experts: the same logits
FREETOKEN_DRAFT_VOCAB=latin     # the drafts score the Latin-script tokens only: the same answers measured
# --memory-ratio 0.81 where the other profiles have 0.80: the states a verify step keeps for its rollback take half the
# VRAM they did (6 instead of 12: 364 MiB less on the 7900 XTX, 283 on the XT), given to the expert cache; NVFP4 with
# 3 contexts: 9,246 slots instead of 9,077 with lower VRAM peaks than at 0.80 before, +1.2 % for one request, +2.8 %
# for three, the same answers. EXL3 3.05 bpw at EXL3_RATIO=0.78: 11,647 slots instead of 11,437, +1.3 % and +1.9 % (four)
# NVFP4 with 3 contexts: add `--max-running-requests 3 --cuda-graph-max-bs 3` after `--kv-reserve-tokens 787500` to size
# the state pools and the graphs for three requests too (9,488 slots: +2.0 % for one request, +5.3-5.6 % for three
# over the build before; a fourth request at once then waits)
FT_ARGS="--moe-strategy offload --moe-cache-auto --expert-load parallel --quant-backend moe.nvfp4=triton --ple-backend disk --max-running-requests 4 --cuda-graph-max-bs 4 --max-prefill-length 16384 --memory-ratio 0.81 --moe-prefill-hit-d2d --tp-size 2 --disable-pynccl --tool-call-parser qwen3_coder --reasoning-parser qwen3"
