# Experimental, measured with EXL3 3.05 bpw: 4 conversations of up to 262,144 tokens at once on 7900 XTX + 7900 XT.
# Qwen3.8-Flash-Next on RX 7900 XTX (rank 0) + RX 7900 XT (rank 1): the attention K/V lives in host RAM (FREETOKEN_QSA_KV_HOST), so the pool holds 4 full contexts
# (1.05M tokens) where xtx-xt shares 250k between the requests; each request stops at the model's native 262,144
# positions. Measured with EXL3 3.05 bpw only (2026-10-10, docs/rdna3/long-context.md): 11.3k experts in the GPU
# caches; 4 cold 256k-token prompts read in 463 s (2218 tok/s); 4 agents at 257-260k decode at 29-30 tok/s each, 2 at
# 57-61, one alone at 91 (94 on xtx-xt at 237k); next turn of a cached 260k conversation 1.8-4.6 s; ~77 GiB of host RAM
# locked. NVFP4 untested (its experts alone take 63 GiB of RAM).
GPUS=2
# minimum VRAM per rank in GiB (the automatic GPU choice uses it)
VRAM_GIB="24 20"
CTX=262144
KV_TOKENS=1050000               # the K/V pool the requests share: 4 x 262,144 and the decode's spare page per request
MEMORY=104g
TESTED=1
FREETOKEN_TP_ALLOW_IMBALANCE=1
FREETOKEN_TP_SPLIT=0.55
FREETOKEN_INT8_DENSE=1
FREETOKEN_HOST_ALLREDUCE=1
FREETOKEN_NVFP4_PREFILL_TUNED=1
FREETOKEN_NVFP4_DECODE_TUNED=1
FREETOKEN_HOST_KV=0             # the conversation tier would pin more RAM; the pool already holds the 4 contexts
FREETOKEN_QSA_KV_HOST=1
FREETOKEN_MTP=1                 # MTP draft head, greedy answers unchanged (rdna3/serve.sh --no-mtp turns it off)
FREETOKEN_SPEC_VERIFY_M=4
FREETOKEN_SPEC_BS_MAX=2         # three or four requests at once decode without drafts
FT_ARGS="--moe-strategy offload --moe-cache-auto --expert-load parallel --quant-backend moe.nvfp4=triton --ple-backend disk --max-running-requests 4 --cuda-graph-max-bs 4 --max-prefill-length 16384 --memory-ratio 0.80 --moe-prefill-hit-d2d --tp-size 2 --disable-pynccl --tool-call-parser qwen3_coder --reasoning-parser qwen3"
