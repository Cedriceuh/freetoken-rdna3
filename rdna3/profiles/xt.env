# Qwen3.8-Flash-Next NVFP4 on one RX 7900 XT 20 GB (the other GPUs stay free).
# Measured (docs/rdna3/benchmarks.md): decode 28.5 tok/s, 27-28 tok/s up to 124k tokens of context; 8.4k-token
# prompt in 8.9 s cold; agent turn 2.4-2.7 s; one request at a time. 0.8 GiB of VRAM left at 124k: 131k is its limit.
# 8k prefill chunks: with 16k (the two-card setting) one card runs out of working memory and a 60k prompt took 166 s.
GPUS=1
# minimum VRAM per rank in GiB (the automatic GPU choice uses it)
VRAM_GIB=20
CTX=131072
MEMORY=110g
TUNABLEOP=1
FREETOKEN_INT8_DENSE=1
FREETOKEN_NVFP4_PREFILL_TUNED=1
FREETOKEN_NVFP4_DECODE_TUNED=1
FREETOKEN_HOST_KV=1
FREETOKEN_HOST_KV_TOKENS=131072
FREETOKEN_HOST_KV_SNAPSHOTS=16
FT_ARGS="--moe-strategy offload --moe-cache-auto --expert-load parallel --quant-backend moe.nvfp4=triton --ple-backend disk --max-running-requests 1 --max-prefill-length 8192 --memory-ratio 0.80 --moe-prefill-hit-d2d --tp-size 1 --disable-pynccl --tool-call-parser qwen3_coder --reasoning-parser qwen3"
