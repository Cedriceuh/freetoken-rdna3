# UNTESTED: derived from xtx-xt, not measured. Qwen3.8-Flash-Next NVFP4 on two RX 7900 XT 20 GB, tensor parallel.
# Even split (identical cards). Each XT holds half of every expert instead of 45 %: slightly fewer cached experts
# than xtx-xt (~6.5k instead of 7.1k, estimate), and each XT does 50 % of the split work: expect decode a little
# below xtx-xt. The 16k prefill chunks and the 0.80 memory ratio are the ones the XT runs with in xtx-xt.
# ~82 GiB of host RAM (estimated, 128 GB machine). Please report what you measure.
TESTED=0
GPUS=2
# minimum VRAM per rank in GiB (the automatic GPU choice uses it)
VRAM_GIB="20 20"
CTX=250000
MEMORY=110g
TUNABLEOP=0
FREETOKEN_TP_ALLOW_IMBALANCE=1
FREETOKEN_INT8_DENSE=1
FREETOKEN_HOST_ALLREDUCE=1
FREETOKEN_NVFP4_PREFILL_TUNED=1
FREETOKEN_NVFP4_DECODE_TUNED=1
FREETOKEN_HOST_KV=1
FREETOKEN_MTP=1                 # MTP draft head, greedy answers unchanged (rdna3/serve.sh --no-mtp turns it off)
FREETOKEN_SPEC_VERIFY_M=4       # up to 4 rows per verify step; the adaptive depth picks 2-4 (2 on one card)
FT_ARGS="--moe-strategy offload --moe-cache-auto --expert-load parallel --quant-backend moe.nvfp4=triton --ple-backend disk --max-running-requests 4 --cuda-graph-max-bs 4 --max-prefill-length 16384 --memory-ratio 0.80 --moe-prefill-hit-d2d --tp-size 2 --disable-pynccl --tool-call-parser qwen3_coder --reasoning-parser qwen3"
